# Template file for 'orbolay'
pkgname=orbolay
version=3.5.0
revision=1
archs="x86_64"
depends="libX11 libXtst libstdc++ fontconfig freetype libglvnd libxcb gtk+3"
short_desc="Quick, small, native Discord overlay alternative"
maintainer="creations <creations@creations.works>"
license="GPL-3.0-or-later"
homepage="https://github.com/SpikeHD/Orbolay"
distfiles="https://github.com/SpikeHD/Orbolay/releases/download/v${version}/orbolay-x86_64-unknown-linux-gnu>orbolay-${version}"
checksum=f386122a9bbaa00190751a5f2d4cca79d65b7c5f430209cc372fa833374490ab
nostrip=yes
allow_unknown_shlibs=yes
skip_extraction="orbolay-${version}"

do_install() {
	install -Dm755 ${XBPS_SRCDISTDIR}/${pkgname}-${version}/orbolay-${version} \
		${DESTDIR}/usr/bin/orbolay
	vinstall ${FILESDIR}/orbolay.desktop 644 usr/share/applications
}
