# Template file for 'goverlay'
pkgname=goverlay
version=1.9.0
revision=1
_appimage="goverlay-${version}-x86_64.AppImage"
archs="x86_64"
create_wrksrc=yes
short_desc="Easy graphical interface to configure MangoHud, vkBasalt, and OptiScaler"
_category=Gaming
maintainer="creations <creations@creations.works>"
license="GPL-3.0-or-later"
homepage="https://github.com/benjamimgois/goverlay"
distfiles="https://github.com/benjamimgois/goverlay/releases/download/${version}/${_appimage}"
checksum=93f39216ef6e5c34ca30e47746fa5ad22d7c9c9c6867ce8cc4ba0cf508cfdd80
nostrip=yes
allow_unknown_shlibs=yes

do_extract() {
	local _path="${XBPS_SRCDISTDIR}/${pkgname}-${version}/${_appimage}"
	chmod +x "$_path"
	"$_path" --appimage-extract
	cp -a squashfs-root/. .
	rm -rf squashfs-root
}

do_install() {
	vmkdir usr/lib/goverlay
	vcopy AppRun usr/lib/goverlay
	vcopy AppRun.lib usr/lib/goverlay
	vcopy AppRun.sh usr/lib/goverlay
	vcopy bin usr/lib/goverlay
	vcopy lib usr/lib/goverlay
	vcopy shared usr/lib/goverlay
	vcopy sharun usr/lib/goverlay
	vcopy share usr/lib/goverlay
	vcopy etc usr/lib/goverlay
	chmod 755 ${DESTDIR}/usr/lib/goverlay/AppRun
	chmod 755 ${DESTDIR}/usr/lib/goverlay/AppRun.sh
	chmod 755 ${DESTDIR}/usr/lib/goverlay/sharun
	chmod 755 ${DESTDIR}/usr/lib/goverlay/bin/goverlay
	vbin ${FILESDIR}/goverlay.sh goverlay
	vinstall ${FILESDIR}/goverlay.desktop 644 usr/share/applications
	vinstall ${FILESDIR}/goverlay.png 644 usr/share/pixmaps
	vlicense ${FILESDIR}/LICENSE
}
