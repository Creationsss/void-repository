# Template file for 'umu-launcher'
pkgname=umu-launcher
version=1.4.4
revision=1
archs="x86_64"
hostmakedepends="bash cargo python3-build python3-installer hatchling"
depends="python3 python3-xlib python3-urllib3 python3-pyzstd python3-xxhash
 python3-truststore python3-filelock bash curl dbus desktop-file-utils
 diffutils freetype gdk-pixbuf hicolor-icon-theme libcurl libxcrypt-compat
 lsof nss usbutils xrandr xdg-user-dirs zenity vulkan-loader
 glibc-32bit libxcrypt-32bit libxcrypt-compat-32bit libstdc++-32bit
 libX11-32bit libXScrnSaver-32bit alsa-plugins-32bit nss-32bit
 vulkan-loader-32bit mesa-32bit"
short_desc="Unified Launcher for Windows Games on Linux (Proton runner)"
_category=Gaming
maintainer="creations <creations@creations.works>"
license="GPL-3.0-only"
homepage="https://github.com/Open-Wine-Components/umu-launcher"
distfiles="https://github.com/Open-Wine-Components/umu-launcher/archive/refs/tags/${version}.tar.gz"
checksum=19767e226b0b937b1dcdcd00282eb31d1a7bb42ee01d54f6dae78e44ab8e3284

do_configure() {
	bash ./configure.sh --prefix=/usr --use-system-pyzstd --use-system-urllib
}

do_build() {
	# Skip umu-vendored — we use system python3-{xlib,pyzstd,urllib3} instead.
	# Submodules in subprojects/ aren't shipped in the release tarball.
	# umu-docs skipped to avoid pulling scdoc (autoremove blast surface).
	make umu-dist umu-delta
}

do_install() {
	make DESTDIR="${DESTDIR}" umu-dist-install umu-delta-install
	vlicense LICENSE
}
