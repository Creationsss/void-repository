post_extract() {
	# submodules are nested: wrapper/submodule (e.g. moonlight-common-c/moonlight-common-c/)
	rm -rf ${build_wrksrc}/moonlight-common-c/moonlight-common-c
	mv moonlight-common-c-${_common_commit} ${build_wrksrc}/moonlight-common-c/moonlight-common-c

	rm -rf ${build_wrksrc}/qmdnsengine/qmdnsengine
	mv qmdnsengine-${_qmdns_commit} ${build_wrksrc}/qmdnsengine/qmdnsengine

	rm -rf ${build_wrksrc}/h264bitstream/h264bitstream
	mv h264bitstream-${_h264bs_commit} ${build_wrksrc}/h264bitstream/h264bitstream

	rm -rf ${build_wrksrc}/moonlight-common-c/moonlight-common-c/enet
	mv enet-${_enet_commit} ${build_wrksrc}/moonlight-common-c/moonlight-common-c/enet

	rm -rf ${build_wrksrc}/app/SDL_GameControllerDB
	mv SDL_GameControllerDB-${_gamecontrollerdb_commit} ${build_wrksrc}/app/SDL_GameControllerDB
}
