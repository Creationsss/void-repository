# Template file for 'vicinae'
pkgname=vicinae
version=0.30.0
revision=1
build_style=cmake
configure_args="-DVICINAE_GIT_TAG=v${version} -DVICINAE_GIT_COMMIT_HASH=402695c
 -DVICINAE_PROVENANCE=creations -DUSE_SYSTEM_GLAZE=ON"
hostmakedepends="pkg-config git curl jq nodejs ninja qt6-tools qt6-shadertools"
makedepends="qt6-base-devel qt6-base-private-devel qt6-declarative-devel qt6-svg-devel qt6-shadertools-devel qt6-multimedia-devel
 qt6-tools-devel layer-shell-qt-devel libqalculate-devel qtkeychain-qt6-devel
 kf6-syntax-highlighting-devel cmark-gfm-devel wayland-devel wayland-protocols glaze"
depends="nodejs qt6-svg qt6-declarative qt6-multimedia layer-shell-qt libqalculate qtkeychain-qt6
 kf6-syntax-highlighting"
short_desc="Focused launcher for your desktop - native, fast, extensible"
_category=Apps
maintainer="creations <creations@creations.works>"
license="GPL-3.0-only"
homepage="https://github.com/vicinaehq/vicinae"
_jkqt_commit=d9b6f18eac22f5e9959a5415d7ba0d8780f24585
distfiles="https://github.com/vicinaehq/vicinae/archive/refs/tags/v${version}.tar.gz
 https://github.com/jkriege2/JKQtPlotter/archive/${_jkqt_commit}.tar.gz>jkqtplotter-${_jkqt_commit}.tar.gz"
checksum="f6ddf9b9ecda6ca5b5a1a655e55c30b9b2352d399985ba9881e8309ef2ac2a99
 e64716932c2e56e97041bcb4dbabe7c9045ea7d60addc4edb38eed43425286e8"
skip_extraction="jkqtplotter-${_jkqt_commit}.tar.gz"

post_extract() {
	vsrcextract -C _deps/jkqtmathtext "jkqtplotter-${_jkqt_commit}.tar.gz"
	cd _deps/jkqtmathtext
	GIT_CEILING_DIRECTORIES="${wrksrc}/_deps" git apply --ignore-whitespace \
		${wrksrc}/cmake/patches/jkqtmathtext-{implication,font-discovery,latex-braces,no-widgets}.patch
}

pre_configure() {
	configure_args+=" -DFETCHCONTENT_SOURCE_DIR_JKQTMATHTEXT=${wrksrc}/_deps/jkqtmathtext"
}
